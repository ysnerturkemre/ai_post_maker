#!/bin/bash
set -e

# Wait for Postgres if DATABASE_URL exists
if [ -n "$DATABASE_URL" ]; then
  echo "Waiting for database..."
  bundle exec ruby -e "
    require 'uri'
    require 'pg'
    uri = URI(ENV['DATABASE_URL'])
    begin
      PG.connect(host: uri.host, port: uri.port, user: uri.user, password: uri.password, dbname: uri.path[1..])
      puts 'DB is up!'
    rescue => e
      puts e.message
      sleep 1
      retry
    end
  "
fi

# Prepare DB (create + migrate)
bundle exec rails db:prepare

exec "$@"
